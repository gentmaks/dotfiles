#!/usr/bin/env bash
# tmux copy mode over a Rex pane's scrollback. init.lua runs this in a
# floating pane over BLOCK:
#
#   rex-tmux-copy BLOCK zoomed|-
set -euo pipefail

# Rex terminals get a minimal PATH. Add Homebrew's.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
type rex tmux base64 >/dev/null

src=${1:?usage: rex-tmux-copy BLOCK zoomed|-}
zoom=${2:--}
# Keep the path short: the tmux socket must fit in 104 bytes on macOS
dir=$(mktemp -d /tmp/rex-tmux-copy.XXXXXX)

# Stop tmux, copy any yank, re-zoom and focus the source pane. This float
# closes when the script exits, and focusing first stops Rex focusing a
# neighbouring pane.
finish() {
	local status=$?
	tmux -S "$dir/s" kill-server 2>/dev/null || true
	# Copy with OSC 52, which Rex sends to the clipboard of the machine
	# you're on, also when the pane runs on a remote host
	if [[ -s $dir/s.out ]]; then
		printf '\033]52;c;%s\a' "$(base64 <"$dir/s.out" | tr -d '\n')"
	fi
	rm -rf "$dir"
	if ((status)); then
		read -rsn1 -p "rex-tmux-copy failed ($status). Press a key to close." || true
	fi
	if [[ $zoom == zoomed ]]; then
		rex zoom "$src" --on >/dev/null 2>&1 || true
	fi
	rex focus "$src" >/dev/null 2>&1 || true
}
trap finish EXIT
trap 'exit 129' HUP INT TERM

cat >"$dir/tmux.conf" <<'EOF'
set -g history-limit 250000
set -g status off
set -g escape-time 0
set -g mode-keys vi
set -g mouse on
set -g set-clipboard off
set -g exit-unattached off
set -as terminal-features ',*:RGB'
set -g prefix None

bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi C-v if -F '#{selection_present}' \
	'send -X rectangle-toggle' 'send -X begin-selection ; send -X rectangle-on'
bind -T copy-mode-vi r send -X rectangle-toggle
bind -T copy-mode-vi MouseDragEnd1Pane send -X copy-selection-no-clear
bind -T copy-mode-vi Escape if -F '#{selection_present}' \
	'send -X clear-selection' 'send -X cancel'

# Only y and Enter copy to the clipboard. They set @yank before leaving.
bind -T copy-mode-vi y { set -g @yank 1 ; send -X copy-selection-and-cancel }
bind -T copy-mode-vi Enter { set -g @yank 1 ; send -X copy-selection-and-cancel }

# On leaving copy mode, save the yank next to the socket if y or Enter was
# pressed, then stop the server. Both run in one shell so the kill can't cut
# off the save.
set-hook -g pane-mode-changed {
	if -F '#{pane_in_mode}' {} {
		if -F '#{@yank}' {
			run-shell "tmux -S '#{socket_path}' save-buffer '#{socket_path}.out' 2>/dev/null; tmux -S '#{socket_path}' kill-server"
		} {
			kill-server
		}
	}
}

# Your own copy-mode settings and bindings
source-file -q ~/.config/rex/tmux-copy.conf
EOF

# Keep the final newline. A float draws its terminal one row lower than a
# tiled pane of the same size and hides its bottom row.
rex capture -b "$src" --format vt --unwrap >"$dir/cap.vt"
# Replay in a detached pane so we can position the copy-mode cursor on the
# last nonblank screen row before attaching the floating client.
tmux -S "$dir/s" -f "$dir/tmux.conf" new-session -d -s copy sh -c \
	'cat "$1"; printf "\033]2;rex-tmux-copy-ready\033\\"; exec sleep 2147483647' sh "$dir/cap.vt"

for ((i = 0; i < 1000; i++)); do
	[[ $(tmux -S "$dir/s" display-message -p -t copy:0.0 '#{pane_title}' 2>/dev/null || true) == rex-tmux-copy-ready ]] && break
	tmux -S "$dir/s" has-session -t copy 2>/dev/null || break
	sleep 0.01
done
if [[ $(tmux -S "$dir/s" display-message -p -t copy:0.0 '#{pane_title}' 2>/dev/null || true) != rex-tmux-copy-ready ]]; then
	echo "rex-tmux-copy: timed out replaying the pane" >&2
	exit 1
fi

pane=copy:0.0
height=$(tmux -S "$dir/s" display-message -p -t "$pane" '#{pane_height}')
last_row=$(tmux -S "$dir/s" capture-pane -p -t "$pane" |
	awk 'NF { row = NR - 1 } END { print row + 0 }')
target_row=$last_row
if ((height > 1 && target_row >= height - 1)); then
	# The float hides its bottom row; preserve the existing alignment there.
	target_row=$((height - 2))
fi

tmux -S "$dir/s" copy-mode -t "$pane"
cursor_row=$(tmux -S "$dir/s" display-message -p -t "$pane" '#{copy_cursor_y}')
if ((cursor_row > target_row)); then
	tmux -S "$dir/s" send-keys -t "$pane" -X -N "$((cursor_row - target_row))" cursor-up
elif ((cursor_row < target_row)); then
	tmux -S "$dir/s" send-keys -t "$pane" -X -N "$((target_row - cursor_row))" cursor-down
fi

# The client exits non-zero when copy mode closes and the hook kills the server.
tmux -S "$dir/s" attach-session -t copy || true
